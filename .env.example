# ---- required ----
MONGODB_URI=
MONGODB_DB=DB_NAME

# Provider keys — read by the agent service ONLY, never the gateway.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=          # embeddings (text-embedding-3-small), even if your LLM isn't OpenAI
TAVILY_API_KEY=
SERPAPI_API_KEY=

# ---- models & providers ----
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
EMBEDDING_MODEL=text-embedding-3-small
SEARCH_PROVIDER=tavily               # tavily | serpapi
VECTOR_BACKEND=atlas-vector-search   # or mongo-cosine-scan for a plain local mongod

# ---- services ----
PORT_AGENT=8000
PORT_GATEWAY=8787
AGENT_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=30
LOG_LEVEL=info
# WEB_DIST=    

# ---- caps (two gears, two envelopes) ----
MAX_TOOL_CALLS=8
MAX_WALL_CLOCK_SEC=90
MAX_TOOL_CALLS_DEEP=24
MAX_WALL_CLOCK_SEC_DEEP=240
DEEP_SUB_QUESTIONS_MIN=3
DEEP_SUB_QUESTIONS_MAX=6
DEEP_DAILY_CAP=5
SEARCH_CACHE_TTL_SECONDS=21600
