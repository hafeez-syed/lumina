  "cards": [
    {
      "dot": "cyan",
      "title": "Reachability",
      "items": [
        "The browser reaches exactly one origin",
        "apps/gateway is the only public address",
        "lumina-fde-agent.internal resolves AAAA-only, so the agent binds HOST = ::",
        "GATEWAY_URL is read server-side and never enters the client bundle"
      ]
    },
    {
      "dot": "rose",
      "title": "Why the agent is private",
      "items": [
        "It is the only process holding a provider key",
        "It is the only one enforcing DEEP_DAILY_CAP",
        "A cap you can bypass by calling the service directly is not a cap",
        "Outbound calls are bounded: search 15s, control-plane LLM 20s, page fetch 12s"
      ]
    },
    {
      "dot": "emerald",
      "title": "State and indexes",
      "items": [
        "Authoritative: threads, messages, memories, spaces, documents, chunks",
        "Disposable: searchCache (TTL tier 2) and the in-process LRUs",
        "Indexes: memories_vector, chunks_vector, chunks_text — the whole M0 budget",
        "Upload enqueues a job and returns 202; the worker indexes it afterwards"
      ]
    }
  ]
