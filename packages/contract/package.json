{
  "name": "@lumina/contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The LUMINA API contract: zod schemas + TypeScript types for every route, SSE event, and MongoDB document. This is the source of truth. Do not edit it.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@lumina/typescript-config": "workspace:*",
    "typescript": "catalog:"
  }
}
